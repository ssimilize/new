<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/calc_background"
    android:padding="16dp"
    tools:context=".MainActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="bottom"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvExpression"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:gravity="end"
                android:textColor="@color/calc_function"
                android:textSize="24sp"
                android:maxLines="2"
                android:ellipsize="start"
                tools:text="12 + 8 ×" />

            <TextView
                android:id="@+id/tvResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:gravity="end"
                android:layout_marginTop="8dp"
                android:textColor="@color/calc_display_text"
                android:textSize="56sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="start"
                android:text="0" />

        </LinearLayout>
    </ScrollView>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:rowCount="5"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/btnClear"
            style="@style/CalcButton.Function"
            android:layout_row="0"
            android:layout_column="0"
            android:text="AC" />

        <Button
            android:id="@+id/btnPlusMinus"
            style="@style/CalcButton.Function"
            android:layout_row="0"
            android:layout_column="1"
            android:text="+/-" />

        <Button
            android:id="@+id/btnPercent"
            style="@style/CalcButton.Function"
            android:layout_row="0"
            android:layout_column="2"
            android:text="%" />

        <Button
            android:id="@+id/btnDivide"
            style="@style/CalcButton.Operator"
            android:layout_row="0"
            android:layout_column="3"
            android:text="÷" />

        <Button
            android:id="@+id/btn7"
            style="@style/CalcButton.Number"
            android:layout_row="1"
            android:layout_column="0"
            android:text="7" />

        <Button
            android:id="@+id/btn8"
            style="@style/CalcButton.Number"
            android:layout_row="1"
            android:layout_column="1"
            android:text="8" />

        <Button
            android:id="@+id/btn9"
            style="@style/CalcButton.Number"
            android:layout_row="1"
            android:layout_column="2"
            android:text="9" />

        <Button
            android:id="@+id/btnMultiply"
            style="@style/CalcButton.Operator"
            android:layout_row="1"
            android:layout_column="3"
            android:text="×" />

        <Button
            android:id="@+id/btn4"
            style="@style/CalcButton.Number"
            android:layout_row="2"
            android:layout_column="0"
            android:text="4" />

        <Button
            android:id="@+id/btn5"
            style="@style/CalcButton.Number"
            android:layout_row="2"
            android:layout_column="1"
            android:text="5" />

        <Button
            android:id="@+id/btn6"
            style="@style/CalcButton.Number"
            android:layout_row="2"
            android:layout_column="2"
            android:text="6" />

        <Button
            android:id="@+id/btnMinus"
            style="@style/CalcButton.Operator"
            android:layout_row="2"
            android:layout_column="3"
            android:text="−" />

        <Button
            android:id="@+id/btn1"
            style="@style/CalcButton.Number"
            android:layout_row="3"
            android:layout_column="0"
            android:text="1" />

        <Button
            android:id="@+id/btn2"
            style="@style/CalcButton.Number"
            android:layout_row="3"
            android:layout_column="1"
            android:text="2" />

        <Button
            android:id="@+id/btn3"
            style="@style/CalcButton.Number"
            android:layout_row="3"
            android:layout_column="2"
            android:text="3" />

        <Button
            android:id="@+id/btnPlus"
            style="@style/CalcButton.Operator"
            android:layout_row="3"
            android:layout_column="3"
            android:text="+" />

        <Button
            android:id="@+id/btn0"
            style="@style/CalcButton.Number"
            android:layout_row="4"
            android:layout_column="0"
            android:layout_columnSpan="2"
            android:layout_gravity="fill_horizontal"
            android:text="0" />

        <Button
            android:id="@+id/btnDot"
            style="@style/CalcButton.Number"
            android:layout_row="4"
            android:layout_column="2"
            android:text="." />

        <Button
            android:id="@+id/btnEquals"
            style="@style/CalcButton.Operator"
            android:layout_row="4"
            android:layout_column="3"
            android:text="=" />

    </GridLayout>

</LinearLayout>
