-- A portal's vortex, glow core and pulse ring. `y` is the opening's height as a fraction of the
-- building's visible box (the Raid Portal's ring is centred, the Trading Hub's door sits low) and
-- `k` scales the vortex and core to the opening (tuned in Studio 2026-09-26).
local function portal(swirl: string, core: string, extra, y: number?, k: number?)
	local oy, ok = y or 0.05, k or 1
	local list = {
		{
			sprite = "swirl",
			grey = true,
			color = swirl,
			at = { 0, oy, -0.5 },
			rate = 0.45,
			lifetime = { 3, 3 },
			size = { { 0, 0 }, { 0.25, 5.5 * ok }, { 1, 6 * ok } },
			transparency = { { 0, 1 }, { 0.25, 0.6 }, { 0.75, 0.6 }, { 1, 1 } },
			speed = 0.02,
			direction = "Front",
			orientation = "VelocityPerpendicular",
			rotSpeed = { 60, 90 },
			lightEmission = 0.3,
			lightInfluence = 0,
		},
		{
			sprite = "glow",
			grey = true,
			color = core,
			core = true,
			at = { 0, oy, -0.52 },
			rate = 1,
			lifetime = { 1.5, 2 },
			size = { { 0, 1.5 * ok }, { 0.5, 3.5 * ok }, { 1, 3 * ok } },
			transparency = { { 0, 1 }, { 0.3, 0.6 }, { 1, 1 } },
			speed = 0,
			lightEmission = 0.8,
			lightInfluence = 0,
		},
	}
	for _, spec in extra do
		table.insert(list, spec)
	end
	return list
end

