-- Loot per minute on a cleared stage with global index g.
function Regions.LootPerMinute(g: number)
	return {
		coins = 60 * 1.10 ^ (g - 1),
		food = 0.3,
		treats = 0.1 * (1 + g / 20),
	}
end

-- One-time reward for first clearing a stage.
function Regions.FirstClearReward(g: number, isBoss: boolean)
	local reward = {
		{ kind = "coins", amount = math.floor(100 * 1.10 ^ g) },
		{ kind = "treats", amount = 2 + math.floor(g / 10) },
	}
	if isBoss then
		table.insert(reward, { kind = "gems", amount = 10 })
	end
	return reward
end

