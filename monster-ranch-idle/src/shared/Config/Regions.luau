Regions.ById = {}
for _, r in Regions.List do
	Regions.ById[r.id] = r
end

-- Global stage index 1..80 used for scaling.
function Regions.GlobalIndex(regionId: string, stage: number): number
	local r = Regions.ById[regionId]
	return (r.order - 1) * Regions.StagesPerRegion + stage
end

-- Timed expeditions ---------------------------------------------------------------
Regions.Durations = { 900, 3600, 14400, 28800 }
Regions.DurationBonus = { [900] = 1.0, [3600] = 1.05, [14400] = 1.10, [28800] = 1.20 }
Regions.Slots = { unlocks = { "expeditions", "expedition_slot_2", "expedition_slot_3" }, passSlots = 1, max = 4 }
Regions.SquadSize = { base = 3, withUnlock = 4, unlock = "squad_4" }

-- Loot per minute on a cleared stage with global index g.
function Regions.LootPerMinute(g: number)
	return {
		coins = 60 * 1.10 ^ (g - 1),
		food = 0.3,
		treats = 0.1 * (1 + g / 20),
	}
end

-- One-time reward for first clearing a stage.
function Regions.FirstClearReward(g: number, isBoss: boolean)
	local reward = {
		{ kind = "coins", amount = math.floor(100 * 1.10 ^ g) },
		{ kind = "treats", amount = 2 + math.floor(g / 10) },
	}
	if isBoss then
		table.insert(reward, { kind = "gems", amount = 10 })
	end
	return reward
end

