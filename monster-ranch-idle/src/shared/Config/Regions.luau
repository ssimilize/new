Regions.ById = {}
Regions.MaxStages = Regions.StagesPerRegion -- the most stages any region has (Api bound)
for _, r in Regions.List do
	Regions.ById[r.id] = r
	Regions.MaxStages = math.max(Regions.MaxStages, r.stages or Regions.StagesPerRegion)
end

-- Whether a region has opened (regions without `opensAt` are always open).
function Regions.IsOpen(regionOrId, now: number): boolean
	local r = if type(regionOrId) == "table" then regionOrId else Regions.ById[regionOrId]
	return r ~= nil and (r.opensAt == nil or now >= r.opensAt)
end

-- The next region still waiting for its date, or nil.
function Regions.NextOpening(now: number)
	local best = nil
	for _, r in Regions.List do
		if r.opensAt and now < r.opensAt and (best == nil or r.opensAt < best.opensAt) then
			best = r
		end
	end
	return best
end

-- Number of stages in a region.
function Regions.Stages(regionId: string): number
	local r = Regions.ById[regionId]
	return if r then r.stages or Regions.StagesPerRegion else 0
end

--[[
	The band a stage belongs to: { first, last, unlock, name, enemyLines, levels, rarity,
	colors, depths }. Stages before `depths.from` use the region's own fields.
]]
function Regions.Band(regionId: string, stage: number)
	local r = Regions.ById[regionId]
	assert(r, "unknown region " .. tostring(regionId))
	local d = r.depths
	if d and stage >= d.from then
		return {
			first = d.from,
			last = Regions.Stages(regionId),
			unlock = d.unlock,
			name = d.name,
			enemyLines = d.enemyLines,
			levels = d.levels,
			rarity = d.rarity,
			colors = d.colors or r.colors,
			depths = true,
		}
	end
	return {
		first = 1,
		last = if d then d.from - 1 else Regions.Stages(regionId),
		unlock = r.unlock,
		name = r.name,
		enemyLines = r.enemyLines,
		levels = r.levels,
		rarity = r.rarity,
		colors = r.colors,
		depths = false,
	}
end

-- Global stage index used for loot and reward scaling (meadow 1–20 … gloom 61–80; the
-- Coral Depths continue from `indexFrom`).
function Regions.GlobalIndex(regionId: string, stage: number): number
	local r = Regions.ById[regionId]
	local d = r.depths
	if d and stage >= d.from then
		return d.indexFrom + (stage - d.from) * (d.indexStep or 1)
	end
	return (r.order - 1) * Regions.StagesPerRegion + stage
end

