--!nonstrict
-- guildhall's clip library as ClipDocs, in the game's registration order. First GENERATED by
-- `foundry motion table --build --clips AnimLibrary/Config.luau` (exact: Convert.toGuildhall gives every clip
-- back unchanged); since the game adopted Motion this file is the source. Change a clip with
-- `foundry motion edit <id>` and `foundry motion table --put <saved .clip.json>`, then sync.
-- The game reads it as kernel.Foundry.rules.Motion.guildhall (FoundryAdapter's `tables` folder).
-- Split into 2 parts, each under 180000 characters (Roblox refuses a Script.Source
-- of 200000 or more): the list is part1 .. part2 in order.
local list = {}
for _, part in { require("@self/part1"), require("@self/part2") } do
	table.move(part, 1, #part, #list + 1, list)
end
return list
