-- Reactions crowd refs -> the emotes a crowd member picks (weights). events = the catalogue
-- events that summon that crowd (documentation; the catalogue is the source of truth).
Library.crowds = table.freeze({
	gawkers = { emotes = { point = 3, clap = 2, shrug = 1 }, events = { "Gear.Crafted" } },
	shoppers = { emotes = { point = 2, shrug = 2, clap = 1 }, events = { "Market.Sold" } },
	welcome_party = { emotes = { wave = 3, cheer = 2, clap = 2 }, events = { "Expeditions.Returned" } },
	celebrants = { emotes = { cheer = 3, clap = 3, wave = 1 }, events = { "GuildRank.Up" } },
	browsers = { emotes = { point = 2, shrug = 2, wave = 1 }, events = { "Merchant.Arrived" } },
	stargazers = { emotes = { point = 3, startle = 1, clap = 1 }, events = { "Stars.Landed" } },
	onlookers = { emotes = { clap = 2, point = 2, startle = 1 }, events = { "Eggs.Hatched", "Community.Trick" } },
