--!strict
-- The Motion library: work loops for every Life role, crowd emotes for Reactions, as ClipDocs.
--
--   Library.clips[id]                         every ClipDoc (reused + authored)
--   Library.work[loop] -> clip id             sweep hammer carry farm fish chat sit sell
--   Library.emotes[emote] -> clip id          cheer clap point wave startle shrug
--   Library.roles                             rows { game, role, activity, placeKind?, loop, weight }
--   Library.crowds[crowdRef]                  { emotes = { [emote] = weight }, events = { ... } }
--   Library.events                            rows { game, event, emote } (a single rig reacts)
--   Library.workFor(game, role, activity, placeKind?, seed?) -> clip id?
--   Library.emoteFor(crowdRef, seed) -> clip id?
--   Library.check() -> problems
--
-- reused.luau is GENERATED by `foundry motion library --build --game guildhall` from the ids in
-- Library.sources (Guildhall's own clips, converted exactly); authored.luau holds what no game
-- had. The role rows name Life rules roles and activities (packages/Life/rules/<game>.luau)
-- and the crowd rows name Reactions crowd refs (packages/Reactions/catalogues/<game>.json);
-- tests/Library.spec checks both against those files.

local Motion = nil :: any
local function motion(): any
	if Motion == nil then
		Motion = require("../Motion")
	end
	return Motion
end
local M = require("../Math")

local Library = {}

-- Which Guildhall clips the library reuses as they are (the generator converts these).
Library.sources = table.freeze({
	guildhall = table.freeze({
		"sweep", "hammer", "carry_crate", "rake", "fish_idle", "chat_idle", "sit.idle",
		"emote.cheer", "emote.point", "emote.wave", "emote.shrug",
	}),
})

local clips: { [string]: any } = {}
for _, d in require("./reused") :: any do
	clips[d.id] = d
end
for _, d in require("./authored") :: any do
	clips[d.id] = d
end
Library.clips = clips

Library.work = table.freeze({
	sweep = "sweep",
	hammer = "hammer",
	carry = "carry_crate",
	farm = "rake",
	fish = "fish_idle",
	chat = "chat_idle",
	sit = "sit.idle",
	sell = "sell",
})

Library.emotes = table.freeze({
	cheer = "emote.cheer",
	clap = "emote.clap",
	point = "emote.point",
	wave = "emote.wave",
	startle = "emote.startle",
	shrug = "emote.shrug",
})

-- Life roles -> work loops. activity = a Life activity id; placeKind narrows it to the kind
-- of place the activity happens at (Life's poi kinds); weight picks among rows that match.
Library.roles = table.freeze({
	-- Guildhall (packages/Life/rules/guildhall.luau)
	{ game = "guildhall", role = "villager", activity = "visit", placeKind = "work", loop = "hammer", weight = 2 },
	{ game = "guildhall", role = "villager", activity = "visit", placeKind = "work", loop = "sell", weight = 2 },
	{ game = "guildhall", role = "villager", activity = "visit", placeKind = "work", loop = "farm", weight = 1 },
	{ game = "guildhall", role = "villager", activity = "visit", placeKind = "home", loop = "sweep", weight = 1 },
	{ game = "guildhall", role = "villager", activity = "visit", placeKind = "social", loop = "chat", weight = 1 },
	{ game = "guildhall", role = "villager", activity = "look", placeKind = "water", loop = "fish", weight = 1 },
	{ game = "guildhall", role = "villager", activity = "sit", loop = "sit", weight = 1 },
	{ game = "guildhall", role = "villager", activity = "carry", loop = "carry", weight = 1 },
	{ game = "guildhall", role = "lamplighter", activity = "rest", loop = "sit", weight = 1 },
	{ game = "guildhall", role = "child", activity = "rest", loop = "sit", weight = 1 },
	-- Monster Ranch (packages/Life/rules/monster-ranch.luau)
	{ game = "monster-ranch", role = "ranchhand", activity = "feed", loop = "farm", weight = 1 },
	{ game = "monster-ranch", role = "ranchhand", activity = "tend", loop = "sweep", weight = 2 },
	{ game = "monster-ranch", role = "ranchhand", activity = "tend", loop = "hammer", weight = 1 },
	{ game = "monster-ranch", role = "ranchhand", activity = "carry", loop = "carry", weight = 1 },
	{ game = "monster-ranch", role = "visitor", activity = "watch", loop = "chat", weight = 1 },
	{ game = "monster-ranch", role = "visitor", activity = "watch", placeKind = "market", loop = "sell", weight = 1 },
	{ game = "monster-ranch", role = "visitor", activity = "watch", placeKind = "fountain", loop = "sit", weight = 1 },
	{ game = "monster-ranch", role = "visitor", activity = "watch", placeKind = "trough", loop = "fish", weight = 1 },
