-- Single-rig reactions (no crowd): an event -> the emote the nearest townsfolk play.
Library.events = table.freeze({
	{ game = "guildhall", event = "Heroes.LeveledUp", emote = "cheer" },
	{ game = "guildhall", event = "Weather.Changed", emote = "shrug" },
	{ game = "monster-ranch", event = "Weather.Lightning", emote = "startle" },
	{ game = "monster-ranch", event = "Monsters.Evolved", emote = "clap" },
})

local function pickWeighted(rows: { any }, weightOf: (any) -> number, seed: number?): any
	local total = 0
	for _, r in rows do
		total += weightOf(r)
	end
	if total <= 0 then
		return nil
	end
	local u = M.hash01(seed or 0, 31) * total
	for _, r in rows do
		u -= weightOf(r)
		if u < 0 then
			return r
		end
	end
	return rows[#rows]
end

-- workFor(game, role, activity, placeKind?, seed?) -> clip id or nil. Rows with the same
-- placeKind win over rows without one; the seed picks among them by weight.
function Library.workFor(game: string, role: string, activity: string, placeKind: string?, seed: number?): string?
	local exact, loose = {}, {}
	for _, r in Library.roles do
		if r.game == game and r.role == role and r.activity == activity then
			if r.placeKind == nil then
				table.insert(loose, r)
			elseif r.placeKind == placeKind then
				table.insert(exact, r)
			end
		end
	end
	local row = pickWeighted(if #exact > 0 then exact else loose, function(r)
		return r.weight or 1
	end, seed)
	return row and Library.work[row.loop]
end

function Library.emoteFor(crowd: string, seed: number): string?
	local c = Library.crowds[crowd]
	if c == nil then
		return nil
	end
	local names = {}
	for n in c.emotes do
		table.insert(names, n)
	end
	table.sort(names)
	local name = pickWeighted(names, function(n)
		return c.emotes[n]
	end, seed)
	return name and Library.emotes[name]
end

function Library.check(): { string }
	local errs = {}
	local Mo = motion()
	local ids = {}
	for id in clips do
		table.insert(ids, id)
	end
	table.sort(ids)
	for _, id in ids do
		for _, p in Mo.validate(clips[id]) do
			table.insert(errs, "clip " .. p)
		end
	end
	for name, id in Library.work do
		if clips[id] == nil then
			table.insert(errs, `work loop {name}: no clip '{id}'`)
		elseif clips[id].loop ~= true then
			table.insert(errs, `work loop {name}: clip '{id}' does not loop`)
		end
	end
	for name, id in Library.emotes do
		if clips[id] == nil then
			table.insert(errs, `emote {name}: no clip '{id}'`)
		end
	end
	for i, r in Library.roles do
		if Library.work[r.loop] == nil then
			table.insert(errs, `role row {i} ({r.game} {r.role}): unknown loop '{r.loop}'`)
		end
	end
	for name in Library.work do
		local used = false
		for _, r in Library.roles do
			if r.loop == name then
				used = true
			end
		end
		if not used then
			table.insert(errs, `work loop {name}: no role row uses it`)
		end
	end
	for ref, c in Library.crowds do
		for e in c.emotes do
			if Library.emotes[e] == nil then
				table.insert(errs, `crowd {ref}: unknown emote '{e}'`)
			end
		end
	end
	for i, r in Library.events do
		if Library.emotes[r.emote] == nil then
			table.insert(errs, `event row {i} ({r.event}): unknown emote '{r.emote}'`)
		end
	end
	return errs
end

return Library
