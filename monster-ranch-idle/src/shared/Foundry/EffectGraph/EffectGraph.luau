--!strict
-- EffectGraph (FX1 VFX Workbench): effects as layered graphs, planned into timed commands.
--
-- Pure logic. The game owns every Instance: it passes a sink that creates, pools and destroys
-- ParticleEmitters / Beams / Trails / Lights / Sounds for the commands a Player hands it.
--
--   local EffectGraph = require("../EffectGraph/EffectGraph")
--   local timeline = EffectGraph.plan(graph, { quality = 2, night = 0.5, sprites = meta })
--   local c = EffectGraph.cost(graph)           -- { particles, emitters, beams, lights, sounds, score, ... }
--   local player = EffectGraph.Player.new(adapter, function(cmd) ... end)
--   local h, why = player:play(timeline)        -- nil, "budget" when adapter.budget("fxCost") is full
--   player:step()                               -- every frame (or on a timer): dispatches due commands
--   player:stop(h)                              -- releases a loop (or anything) early
--   local preset = EffectGraph.toClientFx(graph) -- a ClientFx preset (Guildhall), inverse of the importer
--   local specs = EffectGraph.toSpecs(graph)     -- a specsets spec list (Monster Ranch), as the source wrote it
--   local presets = EffectGraph.toSpecsets(graphs) -- { [table] = specs | { [key] = specs } }
--
-- library/<game>.luau (generated by `foundry vfx export --write` from graphs/<game>.json) is the
-- game's graph list; the game reads it as kernel.Foundry.libraries.EffectGraph.<game>.
--
-- A GRAPH (schema: foundry/tools/vfx/effect.schema.json):
--   { id, kind = "loop" | "burst" | "moment", layers = { layer }, tags = { string },
--     cost? (declared budget units at high quality), lifetime? (s, burst/moment end) }
-- A LAYER:
--   { id, kind = "emitter" | "beam" | "trail" | "flash" | "decal" | "shake" | "sound" | "light",
--     at (s), duration (s; 0 = instant, or "until the effect ends" for a running emitter or a
--     held layer), props = { Roblox-shaped properties }, sprite?, attach? = "origin" | "target" |
--     "ground", offset? {x,y,z}, box? {x,y,z}, anchor?, host?, emit? (burst count),
--     minQuality? ("low" | "medium" | "high"), tinted?, takesColor?, nightGlow?, bright? }
--
-- A TIMELINE (plan's result):
--   { id, kind, quality, duration (s; nil for a loop: it runs until stopped), cost (budget units
--     at this quality), metrics (cost table), warnings = { string }, commands = { command } }
-- A COMMAND: { t (s from start), op, layer, kind, pool, ... }
--   op "acquire"  take an Instance of `kind` from pool `pool` (kind/sprite) and apply `props`
--      "enable" / "disable"  an emitter's Rate on / off
--      "emit"     :Emit(count) on an acquired emitter
--      "fire"     one-shot layers (shake, sound): no Instance is held
--      "release"  return the layer's Instance to its pool
-- Player adds `handle`, `effect` and `at` (absolute adapter time) to each command it dispatches.

local Contract = require("../Contract/Contract")

local EffectGraph = {}

EffectGraph.SCHEMA = "foundry.effect/1"

EffectGraph.KINDS = table.freeze({ loop = true, burst = true, moment = true })
EffectGraph.LAYER_KINDS = table.freeze({
	emitter = true,
	beam = true,
	trail = true,
	flash = true,
	decal = true,
	shake = true,
	sound = true,
	light = true,
})
local ATTACH = { origin = true, target = true, ground = true }
local QUALITY_RANK: { [string]: number } = { low = 1, medium = 2, high = 3 }

-- Per-tier multipliers (1 low, 2 medium, 3 high). A caller may pass its own in params.qualityScale.
EffectGraph.QUALITY_SCALE = table.freeze({
	table.freeze({ rate = 0.35, count = 0.4, cost = 0.35 }),
	table.freeze({ rate = 0.65, count = 0.7, cost = 0.65 }),
	table.freeze({ rate = 1, count = 1, cost = 1 }),
})

-- score weights: roughly live particles / 10, +2 a light, +1 a beam or trail, +1 a flash,
-- +0.5 a decal. Shakes and sounds are counted but cost nothing.
EffectGraph.WEIGHTS = table.freeze({ particle = 0.1, light = 2, beam = 1, flash = 1, decal = 0.5 })

-- Phases order commands that share a time: take, switch on, burst, one-shots, switch off, give back.
local PHASE: { [string]: number } = { acquire = 1, enable = 2, emit = 3, fire = 3, disable = 4, release = 5 }

------------------------------------------------------------------------------------------
-- value helpers
------------------------------------------------------------------------------------------

-- range(v) -> lo, hi for a number, { lo, hi } or { min =, max = }; 0, 0 for anything else.
function EffectGraph.range(v: any): (number, number)
	if type(v) == "number" then
		return v, v
	elseif type(v) == "table" then
		if type(v[1]) == "number" then
			return v[1], if type(v[2]) == "number" then v[2] else v[1]
		elseif type(v.min) == "number" then
			return v.min, if type(v.max) == "number" then v.max else v.min
		end
	end
	return 0, 0
end

local function qualityIndex(q: any): number
	if type(q) == "string" then
		return QUALITY_RANK[q] or 3
	elseif type(q) == "number" then
		return math.clamp(math.floor(q), 1, 3)
	end
	return 3
end

local function layerRank(layer: any): number
	return if type(layer.minQuality) == "string" then (QUALITY_RANK[layer.minQuality] or 1) else 1
end

local function props(layer: any): { [string]: any }
	return if type(layer.props) == "table" then layer.props else {}
end

-- the longest a particle (emitter) or trail segment lives after its layer stops
local function tail(layer: any): number
	local p = props(layer)
	if layer.kind == "emitter" then
		local _, hi = EffectGraph.range(p.Lifetime)
		return hi
	elseif layer.kind == "trail" then
		local _, hi = EffectGraph.range(p.Lifetime)
		return hi
	end
	return 0
end

local function scaledCount(n: number, f: number): number
	if n <= 0 then
		return 0
	end
	return math.max(1, math.floor(n * f + 0.5))
end

local function copy(t: { [string]: any }): { [string]: any }
	local out = {}
	for k, v in t do
		out[k] = v
	end
	return out
end

------------------------------------------------------------------------------------------
-- check
------------------------------------------------------------------------------------------

-- check(graph) -> { problem } ({} when the graph can be planned). The full schema check is
-- `foundry vfx validate`; this is the part plan() cannot work without.
function EffectGraph.check(graph: any): { string }
	local errs = {}
	if type(graph) ~= "table" then
		return { "a graph must be a table" }
	end
	if type(graph.id) ~= "string" or graph.id == "" then
		table.insert(errs, "id must be a non-empty string")
	end
	if not EffectGraph.KINDS[graph.kind] then
		table.insert(errs, `kind must be loop, burst or moment (got {tostring(graph.kind)})`)
	end
	if type(graph.layers) ~= "table" or #graph.layers == 0 then
		table.insert(errs, "layers must be a non-empty list")
		return errs
	end
	local seen = {}
	for i, layer in graph.layers do
		local where = `layers[{i}]`
		if type(layer) ~= "table" then
			table.insert(errs, where .. " must be a table")
			continue
		end
		if type(layer.id) ~= "string" or layer.id == "" then
			table.insert(errs, where .. ".id must be a non-empty string")
		elseif seen[layer.id] then
			table.insert(errs, `{where}.id '{layer.id}' is used twice`)
		else
			seen[layer.id] = true
		end
		if not EffectGraph.LAYER_KINDS[layer.kind] then
			table.insert(errs, `{where}.kind '{tostring(layer.kind)}' is not a layer kind`)
		end
		if type(layer.at) ~= "number" or layer.at < 0 then
			table.insert(errs, where .. ".at must be a number >= 0")
		end
		if type(layer.duration) ~= "number" or layer.duration < 0 then
			table.insert(errs, where .. ".duration must be a number >= 0")
		end
		if layer.attach ~= nil and not ATTACH[layer.attach] then
			table.insert(errs, `{where}.attach '{tostring(layer.attach)}' must be origin, target or ground`)
		end
		if layer.minQuality ~= nil and not QUALITY_RANK[layer.minQuality] then
			table.insert(errs, `{where}.minQuality '{tostring(layer.minQuality)}' must be low, medium or high`)
		end
		if layer.props ~= nil and type(layer.props) ~= "table" then
			table.insert(errs, where .. ".props must be a table")
		end
	end
	return errs
end

------------------------------------------------------------------------------------------
-- cost
------------------------------------------------------------------------------------------

export type Cost = {
	particles: number, -- live particles: sum of Rate x Lifetime max, plus burst counts
	emitters: number,
	beams: number, -- beams and trails
	lights: number,
	sounds: number,
	flashes: number,
	decals: number,
	shakes: number,
	score: number, -- computed budget units (see WEIGHTS), at least 1
	declared: number?, -- graph.cost scaled to the quality, when the graph declares one
	budget: number, -- what a Player charges: declared when present, else score
	quality: number,
}

-- cost(graph, quality?, qualityScale?) -> Cost. Layers under their minQuality are not counted.
function EffectGraph.cost(graph: any, quality: any?, qualityScale: any?): Cost
	local q = qualityIndex(quality)
	local qs = (qualityScale or EffectGraph.QUALITY_SCALE)[q]
	local c = {
		particles = 0,
		emitters = 0,
		beams = 0,
		lights = 0,
		sounds = 0,
		flashes = 0,
		decals = 0,
		shakes = 0,
		score = 0,
		declared = nil :: number?,
		budget = 0,
		quality = q,
	}
	for _, layer in (if type(graph) == "table" and type(graph.layers) == "table" then graph.layers else {}) do
		if layerRank(layer) > q then
			continue
		end
		local p = props(layer)
		local k = layer.kind
		if k == "emitter" then
			c.emitters += 1
			local _, hi = EffectGraph.range(p.Lifetime)
			local rate = if type(p.Rate) == "number" then p.Rate else 0
			c.particles += rate * qs.rate * hi
			if type(layer.emit) == "number" then
				c.particles += scaledCount(layer.emit, qs.count)
			end
		elseif k == "beam" or k == "trail" then
			c.beams += 1
		elseif k == "light" then
			c.lights += 1
		elseif k == "sound" then
			c.sounds += 1
		elseif k == "flash" then
			c.flashes += 1
		elseif k == "decal" then
			c.decals += 1
		elseif k == "shake" then
			c.shakes += 1
		end
	end
	c.particles = math.floor(c.particles * 1000 + 0.5) / 1000
	local W = EffectGraph.WEIGHTS
	local raw = c.particles * W.particle + c.lights * W.light + c.beams * W.beam + c.flashes * W.flash + c.decals * W.decal
	c.score = math.max(1, math.ceil(raw - 1e-9))
	if type(graph) == "table" and type(graph.cost) == "number" then
		c.declared = math.max(1, math.ceil(graph.cost * qs.cost - 1e-9))
	end
	c.budget = c.declared or c.score
	return c :: Cost
end

------------------------------------------------------------------------------------------
-- plan
------------------------------------------------------------------------------------------

export type Params = {
	quality: any?, -- 1..3 or "low" | "medium" | "high" (default 3)
	night: number?, -- 0 day .. 1 night: lerps sprite lightEmission day -> night
	sprites: { [string]: any }?, -- sprite key -> Sprite Foundry metadata (sprite_meta.schema.json)
	color: any?, -- replaces Color on layers marked takesColor
	qualityScale: any?,
}

local function spriteRules(layer: any, p: { [string]: any }, params: Params, warnings: { string })
	local key = layer.sprite
	if type(key) ~= "string" or params.sprites == nil then
		return
	end
	local meta = (params.sprites :: any)[key]
	if type(meta) ~= "table" then
		table.insert(warnings, `layer '{layer.id}': sprite '{key}' has no metadata`)
		return
	end
	local le = meta.lightEmission
	if (layer.kind == "emitter" or layer.kind == "beam" or layer.kind == "trail") and type(le) == "table" then
		local day = if type(le.day) == "number" then le.day else 0
		local nightV = if type(le.night) == "number" then le.night else day
		local n = math.clamp(if type(params.night) == "number" then params.night else 0, 0, 1)
		if type(p.LightEmission) == "number" then
			local w = if type(layer.nightGlow) == "number" then layer.nightGlow else 1
			p.LightEmission = math.clamp(p.LightEmission + (nightV - day) * n * w, 0, 1)
		else
			p.LightEmission = day + (nightV - day) * n
		end
	end
	if meta.tint == "own" and (layer.tinted == true or layer.takesColor == true) then
		table.insert(warnings, `layer '{layer.id}': sprite '{key}' keeps its own colours but the layer tints it`)
	end
end

-- plan(graph, params?) -> timeline (see the header). Errors on a graph check() refuses.
function EffectGraph.plan(graph: any, params: Params?): any
	local errs = EffectGraph.check(graph)
	if #errs > 0 then
		error("EffectGraph.plan: " .. table.concat(errs, "; "), 2)
	end
	local prm: Params = params or {}
	local q = qualityIndex(prm.quality)
	local qs = (prm.qualityScale or EffectGraph.QUALITY_SCALE)[q]
	local warnings = {}
	local isLoop = graph.kind == "loop"

	-- when a burst / moment ends: its declared lifetime, else its last layer's end
	local finish: number? = nil
	if not isLoop then
		if type(graph.lifetime) == "number" then
			finish = graph.lifetime
		else
			local e = 0
			for _, layer in graph.layers do
				if layerRank(layer) <= q then
					e = math.max(e, layer.at + layer.duration + tail(layer))
				end
			end
			finish = e
		end
	end

	local cmds = {}
	local function push(t: number, op: string, layer: any, index: number, extra: { [string]: any }?)
		local c: { [string]: any } = {
			t = t,
			op = op,
			layer = layer.id,
			kind = layer.kind,
			pool = layer.kind .. "/" .. (if type(layer.sprite) == "string" then layer.sprite else ""),
			_i = index,
		}
		for k, v in extra or {} do
			c[k] = v
		end
		table.insert(cmds, c)
	end

	for index, layer in graph.layers do
		if layerRank(layer) > q then
			continue
		end
		local at: number = layer.at
		local dur: number = layer.duration
		local p = copy(props(layer))
		if layer.takesColor == true and prm.color ~= nil then
			p.Color = prm.color
		end
		if layer.kind == "emitter" and type(p.Rate) == "number" then
			p.Rate = p.Rate * qs.rate
		end
		spriteRules(layer, p, prm, warnings)
		local place = {
			props = p,
			sprite = layer.sprite,
			tinted = layer.tinted,
			attach = layer.attach or "origin",
			offset = layer.offset,
			box = layer.box,
			anchor = layer.anchor,
			host = layer.host,
			duration = dur,
		}
		-- `hold`: when the layer's own part ends (nil = until the effect ends)
		local hold: number? = if dur > 0 then at + dur else nil
		if layer.kind == "shake" or layer.kind == "sound" then
			push(at, "fire", layer, index, place)
		elseif layer.kind == "emitter" then
			push(at, "acquire", layer, index, place)
			local rate = if type(p.Rate) == "number" then p.Rate else 0
			local count = if type(layer.emit) == "number" then scaledCount(layer.emit, qs.count) else 0
			if count > 0 then
				push(at, "emit", layer, index, { count = count })
			end
			local stopAt: number? = nil
			if rate > 0 then
				push(at, "enable", layer, index)
				stopAt = hold or finish
				if stopAt ~= nil then
					push(stopAt, "disable", layer, index)
				end
			else
				stopAt = hold or at
			end
			if stopAt ~= nil then
				push(stopAt + tail(layer), "release", layer, index)
			end
		else
			push(at, "acquire", layer, index, place)
			local stopAt = hold or finish
			if stopAt ~= nil then
				push(stopAt + tail(layer), "release", layer, index)
			end
		end
	end

	table.sort(cmds, function(a, b)
		if a.t ~= b.t then
			return a.t < b.t
		end
		if PHASE[a.op] ~= PHASE[b.op] then
			return PHASE[a.op] < PHASE[b.op]
		end
		return a._i < b._i
	end)
	-- a declared lifetime is a hard end: nothing outlives it (a layer running past it is cut)
	local hardEnd: number? = if not isLoop and type(graph.lifetime) == "number" then graph.lifetime else nil
	local last = 0
	for _, c in cmds do
		c._i = nil
		if hardEnd ~= nil and c.t > hardEnd then
			c.t = hardEnd
		end
		last = math.max(last, c.t)
	end

	local metrics = EffectGraph.cost(graph, q, prm.qualityScale)
	return {
		id = graph.id,
		kind = graph.kind,
		quality = q,
		duration = if isLoop then nil else math.max(finish or 0, last),
		cost = metrics.budget,
		metrics = metrics,
		warnings = warnings,
		commands = cmds,
	}
end

------------------------------------------------------------------------------------------
-- Player
------------------------------------------------------------------------------------------

export type Player = {
	play: (self: Player, timeline: any) -> (number?, string?),
	step: (self: Player) -> number,
	stop: (self: Player, handle: number) -> boolean,
	used: (self: Player) -> number,
	live: (self: Player) -> number,
}

local PlayerMethods = {}
PlayerMethods.__index = PlayerMethods

local function dispatch(self: any, run: any, c: any)
	local out = copy(c)
	out.handle = run.handle
	out.effect = run.timeline.id
	out.at = run.t0 + c.t
	if c.op == "acquire" then
		run.held[c.layer] = c
	elseif c.op == "release" then
		run.held[c.layer] = nil
	end
	self._sink(out)
end

-- play(timeline) -> handle, or nil and "budget" when adapter.budget("fxCost") has no room
-- (nil budget = unlimited). Commands due at t = 0 go out at once.
function PlayerMethods.play(self: any, timeline: any): (number?, string?)
	assert(type(timeline) == "table" and type(timeline.commands) == "table", "Player:play needs a timeline from EffectGraph.plan")
	local cost = if type(timeline.cost) == "number" then timeline.cost else 0
	local cap = self._adapter.budget("fxCost")
	if cap ~= nil and self._used + cost > cap then
		self._adapter.log("warn", "EffectGraph: fxCost budget full, effect refused", {
			effect = timeline.id,
			cost = cost,
			used = self._used,
			cap = cap,
		})
		return nil, "budget"
	end
	self._next += 1
	local run = { handle = self._next, timeline = timeline, t0 = self._adapter.now(), i = 1, held = {}, cost = cost }
	self._used += cost
	table.insert(self._runs, run)
	self:step()
	return run.handle, nil
end

-- step() -> commands dispatched. Finished bursts and moments free their budget.
function PlayerMethods.step(self: any): number
	local now = self._adapter.now()
	local n = 0
	local i = 1
	while i <= #self._runs do
		local run = self._runs[i]
		local cmds = run.timeline.commands
		while run.i <= #cmds and run.t0 + cmds[run.i].t <= now + 1e-9 do
			dispatch(self, run, cmds[run.i])
			run.i += 1
			n += 1
		end
		local ends = run.timeline.duration
		if run.i > #cmds and ends ~= nil and run.t0 + ends <= now + 1e-9 then
			self._used -= run.cost
			table.remove(self._runs, i)
		else
			i += 1
		end
	end
	return n
end

-- stop(handle) -> true when it was live: releases every layer still held, frees the budget.
function PlayerMethods.stop(self: any, handle: number): boolean
	for i, run in self._runs do
		if run.handle == handle then
			local now = self._adapter.now()
			-- release in the order the layers were planned
			for _, layer in run.timeline.commands do
				if layer.op == "acquire" and run.held[layer.layer] then
					dispatch(self, run, {
						t = now - run.t0,
						op = "release",
						layer = layer.layer,
						kind = layer.kind,
						pool = layer.pool,
						stopped = true,
					})
				end
			end
			self._used -= run.cost
			table.remove(self._runs, i)
			return true
		end
	end
	return false
end

function PlayerMethods.used(self: any): number
	return self._used
end

function PlayerMethods.live(self: any): number
	return #self._runs
end

EffectGraph.Player = {
	new = function(adapter: Contract.Adapter, sink: (command: any) -> ()): Player
		assert(type(adapter) == "table" and type(adapter.now) == "function", "Player.new needs a Contract adapter")
		assert(type(sink) == "function", "Player.new needs a sink function")
		local self = { _adapter = adapter, _sink = sink, _runs = {}, _used = 0, _next = 0 }
		return (setmetatable(self, PlayerMethods) :: any) :: Player
	end,
}

------------------------------------------------------------------------------------------
-- toClientFx: a graph back to a ClientFx preset (the format `foundry vfx import` reads)
------------------------------------------------------------------------------------------
-- The exact inverse of foundry/tools/vfx/importers.py gh_export (test_vfx_export.py holds them
-- equal over every graph in graphs/*.json), so a game whose presets were imported can load
-- them from the graph library and build what its old preset table built. Values are deep
-- copies. A layer id "p<i>" drops the part name; at / duration 0 drop delay / duration; a
-- `sound` layer "cue" becomes the preset's `cue`; `carry` fields come back verbatim.

local function deep(v: any): any
	if type(v) ~= "table" then
		return v
	end
	local out = {}
	for k, x in v do
		out[k] = deep(x)
	end
	return out
end

local function vecXYZ(v: any): any
	return { x = v[1], y = v[2], z = v[3] }
end

local CFX_KIND = table.freeze({ burst = "burst", loop = "emitter", moment = "composite" })
local CFX_TYPE = table.freeze({ emitter = "particles", light = "light", beam = "beam", trail = "trail" })
-- camelCase part field -> the Roblox prop it maps to (first letter upper-cased), by part type
local CFX_PROPS = table.freeze({
	particles = table.freeze({
		"color", "size", "transparency", "squash", "lifetime", "rate", "speed", "drag", "rotation",
		"rotSpeed", "lightEmission", "lightInfluence", "brightness", "zOffset", "shape", "shapeStyle",
		"emissionDirection", "orientation", "lockedToPart", "timeScale",
	}),
	light = table.freeze({ "color", "brightness", "range", "shadows" }),
	beam = table.freeze({
		"color", "transparency", "width0", "width1", "textureSpeed", "textureLength", "textureMode",
		"lightEmission", "lightInfluence", "segments", "curveSize0", "curveSize1", "faceCamera",
	}),
	trail = table.freeze({
		"color", "transparency", "lifetime", "widthScale", "lightEmission", "lightInfluence",
		"minLength", "faceCamera",
	}),
})
local CFX_FLIPBOOK = table.freeze({
	layout = "FlipbookLayout", mode = "FlipbookMode", framerate = "FlipbookFramerate", startRandom = "FlipbookStartRandom",
})

local function cfxTexture(layer: any, p: { [string]: any }): any
	if layer.sprite ~= nil then
		return "tex:" .. tostring(layer.sprite)
	end
	return deep(p.Texture)
end

local function cfxPart(layer: any, ptype: any, i: number): { [string]: any }
	local p: { [string]: any } = layer.props or {}
	local part: { [string]: any } = { type = ptype }
	if layer.id ~= "p" .. tostring(i) then
		part.name = layer.id
	end
	if layer.at ~= nil and layer.at ~= 0 then
		part.delay = layer.at
	end
	if layer.duration ~= nil and layer.duration ~= 0 then
		part.duration = layer.duration
	end
	part.minQuality = layer.minQuality
	if layer.offset ~= nil then
		part.offset = vecXYZ(layer.offset)
	end
	for _, name in (CFX_PROPS :: any)[ptype] or {} do
		local v = p[string.upper(string.sub(name, 1, 1)) .. string.sub(name, 2)]
		if v ~= nil then
			part[name] = deep(v)
		end
	end
	if ptype == "particles" then
		part.texture = cfxTexture(layer, p)
		part.count = layer.emit
		if p.SpreadAngle ~= nil then
			part.spreadAngle = { x = p.SpreadAngle[1], y = p.SpreadAngle[2] }
		end
		if p.Acceleration ~= nil then
			part.acceleration = vecXYZ(p.Acceleration)
		end
		if layer.box ~= nil then
			part.shapeSize = vecXYZ(layer.box)
		end
		local fb: { [string]: any } = {}
		local any = false
		for k, prop in CFX_FLIPBOOK do
			if p[prop] ~= nil then
				fb[k] = deep(p[prop])
				any = true
			end
		end
		if any then
			part.flipbook = fb
		end
	elseif ptype == "light" then
		part.flicker = deep(p.Flicker)
		if p.LightType == "SpotLight" then
			part.spot = { angle = p.Angle, face = p.Face }
		end
	elseif ptype == "beam" or ptype == "trail" then
		part.texture = cfxTexture(layer, p)
		if p.Attachment0 ~= nil then
			part.offset0 = vecXYZ(p.Attachment0)
		end
		if p.Attachment1 ~= nil then
			part.offset1 = vecXYZ(p.Attachment1)
		end
	end
	for k, v in layer.carry or {} do
		part[k] = deep(v)
	end
	return part
end

-- toClientFx(graph) -> { id, kind = "burst" | "emitter" | "composite", cost?, lifetime?, cue?, parts }
function EffectGraph.toClientFx(graph: any): { [string]: any }
	assert(type(graph) == "table" and type(graph.layers) == "table", "toClientFx needs a graph")
	local carry = graph.carry or {}
	local out: { [string]: any } = {
		id = graph.id,
		kind = if carry.kind ~= nil then carry.kind else ((CFX_KIND :: any)[graph.kind] or graph.kind),
		cost = graph.cost,
		lifetime = graph.lifetime,
	}
	local parts = {}
	for i, layer in graph.layers do
		if layer.kind == "sound" and layer.id == "cue" then
			out.cue = deep((layer.props or {}).Cue)
			continue
		end
		local ptype = (layer.carry and layer.carry.type) or (CFX_TYPE :: any)[layer.kind]
		table.insert(parts, cfxPart(layer, ptype, i))
	end
	out.parts = parts
	for k, v in carry do
		if k ~= "kind" then
			out[k] = deep(v)
		end
	end
	return out
end

------------------------------------------------------------------------------------------
-- toSpecs / toSpecsets: graphs back to a specsets module (Monster Ranch Config/Vfx)
------------------------------------------------------------------------------------------
-- The exact inverse of foundry/tools/vfx/importers.py mr_export_source (test_vfx_export.py
-- holds them equal over every specsets graph): each emitter layer becomes the spec the source
-- module wrote, so a game can build its old preset table from the library. A layer's `filled`
-- fields (defaults the importer wrote in) are dropped again, and "spread" goes back to one
-- number; `carry` fields come back verbatim. Values are deep copies.

-- spec field -> layer field (the importer's MR_SPEC, inverted)
local SPEC_LAYER = table.freeze({
	sprite = "sprite",
	grey = "tinted",
	useColor = "takesColor",
	emit = "emit",
	at = "anchor",
	offset = "offset",
	box = "box",
	core = "bright",
	night = "nightGlow",
	on = "host",
})
-- spec field -> props field
local SPEC_PROPS = table.freeze({
	color = "Color",
	rate = "Rate",
	lifetime = "Lifetime",
	size = "Size",
	transparency = "Transparency",
	speed = "Speed",
	drag = "Drag",
	rotSpeed = "RotSpeed",
	lightEmission = "LightEmission",
	lightInfluence = "LightInfluence",
	orientation = "Orientation",
	shape = "Shape",
	shapeStyle = "ShapeStyle",
	shapeInOut = "ShapeInOut",
	zOffset = "ZOffset",
	lockedToPart = "LockedToPart",
	spread = "SpreadAngle",
	accel = "Acceleration",
	rot = "Rotation",
	direction = "EmissionDirection",
})

-- toSpecs(graph) -> { spec }: one per layer, in layer order
function EffectGraph.toSpecs(graph: any): { { [string]: any } }
	assert(type(graph) == "table" and type(graph.layers) == "table", "toSpecs needs a graph")
	local out = {}
	for _, layer in graph.layers do
		local p: { [string]: any } = layer.props or {}
		local spec: { [string]: any } = {}
		for k, field in SPEC_LAYER do
			if layer[field] ~= nil then
				spec[k] = deep(layer[field])
			end
		end
		for k, prop in SPEC_PROPS do
			if p[prop] ~= nil then
				spec[k] = deep(p[prop])
			end
		end
		for k, v in layer.carry or {} do
			spec[k] = deep(v)
		end
		for _, k in layer.filled or {} do
			if k == "spread" and type(spec.spread) == "table" then
				spec.spread = spec.spread[1]
			else
				spec[k] = nil
			end
		end
		table.insert(out, spec)
	end
	return out
end

-- toSpecsets(graphs) -> { [table] = { spec } | { [key] = { spec } } }, placed by each graph's
-- source.table / source.key (the importer's names; a graph without them is skipped)
function EffectGraph.toSpecsets(graphs: { any }): { [string]: any }
	local out: { [string]: any } = {}
	for _, graph in graphs do
		local src = type(graph) == "table" and graph.source or nil
		if type(src) ~= "table" or type(src.table) ~= "string" then
			continue
		end
		if src.key == nil then
			out[src.table] = EffectGraph.toSpecs(graph)
		else
			out[src.table] = out[src.table] or {}
			out[src.table][src.key] = EffectGraph.toSpecs(graph)
		end
	end
	return out
end

return EffectGraph
