--[[
	Sheet: reads the packed UI art (UI/Art/Portraits, UI/Art/Icons; both generated by
	tools/ui/atlas.py) and builds ImageLabels for one cell. Every lookup returns nil while the
	cell's sheet id is still "" (not uploaded), so callers keep their procedural drawing.

		local art = Sheet.icon("decor_hay_bale", { Size = UDim2.fromOffset(64, 64), Parent = cell })
		if not art then <draw the placeholder> end

		Sheet.portrait(formId, props)   -- monster portrait cell (UI/Art/Portraits)
		Sheet.icon(name, props)         -- item / currency icon (UI/Art/Icons, names from art/ui/ICONS.md)
		Sheet.find(data, key)           -- image, rect offset, rect size (or nil)
]]

local Create = require(script.Parent.Parent.Create)
local Portraits = require(script.Parent.Portraits)
local Icons = require(script.Parent.Icons)

local Sheet = {}

function Sheet.find(data, key: string?): (string?, Vector2?, Vector2?)
	local cell = if key then data.Cells[key] else nil
	if not cell then
		return nil
	end
	local id = data.Sheets[cell[1]]
	if type(id) ~= "string" or id == "" then
		return nil
	end
	return id, Vector2.new(cell[2], cell[3]), Vector2.new(data.Cell, data.Cell)
end

local function image(data, key: string?, props: { [string]: any }?): ImageLabel?
	local id, offset, size = Sheet.find(data, key)
	if not id then
		return nil
	end
	local all: { [string]: any } = {
		Name = "Art",
		BackgroundTransparency = 1,
		Image = id,
		ImageRectOffset = offset,
		ImageRectSize = size,
		ScaleType = Enum.ScaleType.Fit,
		Size = UDim2.fromScale(1, 1),
	}
	for k, v in props or {} do
		all[k] = v
	end
	return Create.New("ImageLabel", all) -- Create.New parents last
end

function Sheet.has(data, key: string?): boolean
	return Sheet.find(data, key) ~= nil
end

function Sheet.portrait(formId: string?, props: { [string]: any }?): ImageLabel?
	return image(Portraits, formId, props)
end

function Sheet.icon(name: string?, props: { [string]: any }?): ImageLabel?
	return image(Icons, name, props)
end

Sheet.Portraits = Portraits
Sheet.Icons = Icons

return Sheet
