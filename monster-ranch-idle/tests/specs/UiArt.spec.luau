--[[
	UiArt: the packed UI art (UI/Art/Portraits and UI/Art/Icons, generated by tools/ui/atlas.py),
	the Sheet reader, and the components that switch to it: MonsterIcon portraits, Icon kinds,
	Store / Wardrobe / Ranch item art, the Panel and Button 9-slice skins and the rarity Shine.
	Data integrity first, then behaviour through the real client (ClientHarness): with every sheet
	id "" the old procedural drawing must be untouched, and with ids set the art must appear.
]]
return function(t)
	local describe, it, expect = t.describe, t.it, t.expect
	local TestKernel, ClientHarness = t.TestKernel, t.ClientHarness
	local Config = t.Shared("Config")
	local Appearance = t.Shared("Logic.Appearance")

	local function allSystems()
		local list = {}
		for _, name in t.Server("Manifest").Systems do
			if name ~= "World" then
				table.insert(list, name)
			end
		end
		return list
	end

	local function client()
		local h = TestKernel.new({ systems = allSystems() })
		local p = h:Join()
		local c = ClientHarness.new(h, p)
		c:Advance(1)
		return c
	end

	local function expectClean(c)
		local problems = c:Problems()
		if #problems > 0 then
			error(table.concat(problems, "\n\n"), 2)
		end
	end

	local function find(root: Instance, name: string, class: string?): Instance?
		for _, d in root:GetDescendants() do
			if d.Name == name and (class == nil or d.ClassName == class) then
				return d
			end
		end
		return nil
	end

	local function forms(): { [string]: boolean }
		local set = {}
		for _, line in Config.Species.Lines do
			for _, entry in line.forms do
				for _, f in (if entry.id then { entry } else entry) do
					set[f.id] = true
				end
			end
		end
		return set
	end

	local function checkData(data, label: string)
		expect(data.Cell).toBe(256)
		expect(type(data.Sheets)).toBe("table")
		for i, id in data.Sheets do
			expect(type(i)).toBe("number")
			expect(id == "" or string.match(id, "^rbxassetid://%d+$") ~= nil).toBe(true)
		end
		local n = 0
		for key, cell in data.Cells do
			n += 1
			local sheet, x, y = cell[1], cell[2], cell[3]
			if data.Sheets[sheet] == nil or x % 256 ~= 0 or y % 256 ~= 0 or x > 768 or y > 768 then
				error(string.format("%s cell %s points outside its sheet", label, key))
			end
		end
		expect(n > 0).toBe(true)
	end

	describe("UI art data", function()
		it("packs every portrait cell inside a sheet, for forms that exist", function()
			local c = client()
			local Portraits = c:require(c.clientFolder.UI.Art.Portraits)
			checkData(Portraits, "Portraits")
			local known = forms()
			for form in Portraits.Cells do
				if not known[form] then
					error("portrait for a form not in Config.Species: " .. form)
				end
			end
		end)

		it("packs every icon cell inside a sheet, with no two cells sharing a slot", function()
			local c = client()
			local Icons = c:require(c.clientFolder.UI.Art.Icons)
			checkData(Icons, "Icons")
			local seen = {}
			for name, cell in Icons.Cells do
				local slot = string.format("%d:%d:%d", cell[1], cell[2], cell[3])
				if seen[slot] then
					error(string.format("icons %s and %s share a slot", seen[slot], name))
				end
				seen[slot] = name
			end
		end)
	end)

	describe("UI art client", function()
		it("keeps the procedural drawing while sheets are not uploaded", function()
			local c = client()
			local Sheet = c:require(c.clientFolder.UI.Art.Sheet)
			local MonsterIcon = c:require(c.clientFolder.UI.Components.MonsterIcon)
			local Icon = c:require(c.clientFolder.UI.Components.Icon)
			for i in Sheet.Portraits.Sheets do
				Sheet.Portraits.Sheets[i] = ""
			end
			for i in Sheet.Icons.Sheets do
				Sheet.Icons.Sheets[i] = ""
			end
			expect(Sheet.portrait("cindlet")).toBeNil()
			expect(Sheet.icon("cur_coin")).toBeNil()
			local icon = MonsterIcon.new(Appearance.Preview("cindlet"), 80)
			expect(find(icon, "Portrait")).toBeNil()
			expect(#icon:GetDescendants() > 5).toBe(true) -- the blob body, eyes, cheeks
			expect(find(Icon.new("coin", 28), "Art")).toBeNil()
			expectClean(c)
		end)

		it("shows the portrait cell, tinted for variants, once its sheet has an id", function()
			local c = client()
			local Sheet = c:require(c.clientFolder.UI.Art.Sheet)
			local MonsterIcon = c:require(c.clientFolder.UI.Components.MonsterIcon)
			local cell = Sheet.Portraits.Cells.cindlet
			expect(cell ~= nil).toBe(true)
			Sheet.Portraits.Sheets[cell[1]] = "rbxassetid://101"
			local icon = MonsterIcon.new(Appearance.Preview("cindlet"), 80)
			local art = find(icon, "Portrait", "ImageLabel") :: ImageLabel
			expect(art ~= nil).toBe(true)
			expect(art.Image).toBe("rbxassetid://101")
			-- (Roblox datatypes live in the client's environment, not the spec's: compare components)
			expect(art.ImageRectOffset.X).toBe(cell[2])
			expect(art.ImageRectOffset.Y).toBe(cell[3])
			expect(art.ImageRectSize.X).toBe(256)
			local golden = Appearance.Preview("cindlet")
			golden.variant = 1
			local g = find(MonsterIcon.new(golden, 80), "Portrait", "ImageLabel") :: ImageLabel
			expect(g.ImageColor3.B < 1).toBe(true)
			-- a silhouette never reveals the portrait
			expect(find(MonsterIcon.silhouette("cindlet", 64), "Portrait")).toBeNil()
			expectClean(c)
		end)

		it("draws icon kinds and item art from the icon sheet once uploaded", function()
			local c = client()
			local Sheet = c:require(c.clientFolder.UI.Art.Sheet)
			local Icon = c:require(c.clientFolder.UI.Components.Icon)
			for i in Sheet.Icons.Sheets do
				Sheet.Icons.Sheets[i] = "rbxassetid://202"
			end
			local coin = Sheet.Icons.Cells.cur_coin
			expect(coin ~= nil).toBe(true)
			local art = find(Icon.new("coin", 28), "Art", "ImageLabel") :: ImageLabel
			expect(art ~= nil).toBe(true)
			expect(art.ImageRectOffset.X).toBe(coin[2])
			expect(art.ImageRectOffset.Y).toBe(coin[3])
			-- kinds without art (egg, lock) keep their shapes
			expect(find(Icon.new("lock", 28), "Art")).toBeNil()
			expectClean(c)
		end)

		it("opens the item screens with icon art and no problems", function()
			local c = client()
			local Sheet = c:require(c.clientFolder.UI.Art.Sheet)
			for i in Sheet.Icons.Sheets do
				Sheet.Icons.Sheets[i] = "rbxassetid://303"
			end
			for _, name in { "Store", "Wardrobe", "Ranch" } do
				c:Open(name)
				c:Advance(0.5)
				c:Close(name)
			end
			expectClean(c)
		end)

		it("skins panels and buttons with the 9-slice textures when their ids are set", function()
			local c = client()
			local Theme = c:require(c.clientFolder.UI.Theme)
			local Button = c:require(c.clientFolder.UI.Components.Button)
			local Panel = c:require(c.clientFolder.UI.Components.Panel)
			local plain = Button.new({ Text = "Plain" })
			expect(plain.Root:FindFirstChild("Skin")).toBeNil()
			expect(plain.Root:FindFirstChildOfClass("UIStroke").Enabled).toBe(true)
			Theme.Images.ButtonTexture = "rbxassetid://404"
			Theme.Images.PanelTexture = "rbxassetid://405"
			local b = Button.new({ Text = "Skinned" })
			local skin = b.Root:FindFirstChild("Skin") :: ImageLabel
			expect(skin ~= nil).toBe(true)
			expect(skin.ScaleType.Name).toBe("Slice")
			expect(skin.SliceCenter == Theme.Slices.Button.Center).toBe(true)
			expect(b.Root:FindFirstChildOfClass("UIStroke").Enabled).toBe(false)
			expect((b.Root:FindFirstChild("Lip") :: Frame).Visible).toBe(false)
			expect(Button.new({ Text = "Pill", Round = true }).Root:FindFirstChild("Skin")).toBeNil()
			local p = Panel.new({ Title = "Skinned" })
			local pskin = p.Root:FindFirstChild("Skin") :: ImageLabel
			expect(pskin ~= nil).toBe(true)
			expect(pskin.SliceCenter == Theme.Slices.Panel.Center).toBe(true)
			Theme.Images.ButtonTexture = ""
			Theme.Images.PanelTexture = ""
			expectClean(c)
		end)

		it("sweeps a shine over Epic and better cards, never in low graphics", function()
			local c = client()
			local Anim = c:require(c.clientFolder.UI.Anim)
			local MonsterIcon = c:require(c.clientFolder.UI.Components.MonsterIcon)
			local Shine = c:require(c.clientFolder.UI.Components.Shine)
			local function card(rarity: number)
				local a = Appearance.Preview("cindlet")
				a.rarity = rarity
				return MonsterIcon.card(a, 96, "Cindlet")
			end
			expect(card(Shine.MinRarity - 1):FindFirstChild("Shine")).toBeNil()
			local epic = card(Shine.MinRarity)
			local shine = epic:FindFirstChild("Shine") :: Frame
			expect(shine ~= nil).toBe(true)
			expect(shine:FindFirstChildOfClass("UIGradient") ~= nil).toBe(true)
			expect(Shine.attach(epic, Shine.MinRarity)).toBeNil() -- never twice
			expect(card(Config.Rarities.Count):FindFirstChild("Shine") ~= nil).toBe(true)
			Anim.enabled = false
			expect(card(Config.Rarities.Count):FindFirstChild("Shine")).toBeNil()
			Anim.enabled = true
			expectClean(c)
		end)
	end)
end
