*.rbxl
*.rbxlx
*.rbxm
roblox.yml
sourcemap.json

# Generated art (7 GB): Meshy task records hold signed URLs, and models, rigs and renders are
# large. Kept local until the art pipeline picks a home. The game needs none of it: it loads the
# published meshes and textures by id (src/client/Visuals/MeshMonsterAssets.luau), and
# art/export is re-made from the rigs by tools/blender/pipeline.py.
art/meshy/
art/rigs/
art/blender/
art/compare/
art/export/
art/tripo/
art/rbxgen/

# Particle sprites: the finished sprites, their prompts and the bake-off record are kept
# (art/vfx, a few MB); raw generations, third-party store thumbnails, screen grabs and the Studio
# patch bundle are not.
art/vfx/**/raw/
art/vfx/bakeoff/store/
art/vfx/bakeoff/report/strip_store.jpg
art/vfx/bakeoff/shots/
art/vfx/patch.json

# Python bytecode from the art tools.
__pycache__/

# Eggs (tools/blender/eggs.py): the upload-ready meshes and images, the renders and icons are re-made
# by the tool; only the small contact sheet in art/eggs/preview is kept.
art/eggs/*
!art/eggs/preview/

# Extra-clip previews (tools/blender/clips.py --previews), rendered from the rigs.
art/rigs-clips/
